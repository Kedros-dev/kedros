generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  passwordHash String
  name        String
  role        Role     @default(CLIENT)
  createdAt   DateTime @default(now())

  // Admin-controlled account state.
  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(true)

  // Per-client pricing, set by the admin when onboarding.
  oneTimeAmountCents  Int @default(0)
  monthlyAmountCents  Int @default(0)

  // Stripe linkage.
  stripeCustomerId String?              @unique
  oneTimePaidAt    DateTime?
  // First charge date for the monthly plan (null = charge when the client subscribes).
  monthlyStartAt   DateTime?
  subscriptionId   String?              @unique
  subscriptionStatus SubscriptionStatus @default(NONE)

  scheduledInvoices ScheduledInvoice[]
}

enum InvoiceKind {
  SETUP_FEE
  MONTHLY
  CUSTOM
}

enum InvoiceStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELED
}

model ScheduledInvoice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind         InvoiceKind
  title        String
  lineItems    Json
  totalCents   Int
  memo         String?
  daysUntilDue Int @default(7)

  sendAt    DateTime
  status    InvoiceStatus @default(SCHEDULED)
  sentAt    DateTime?

  stripeInvoiceId      String?
  stripeSubscriptionId String?
  hostedInvoiceUrl     String?
  error                String?

  createdAt DateTime @default(now())

  @@index([status, sendAt])
}

// Dedup log for outgoing emails (e.g. receipts keyed "receipt:<invoiceId>"), so
// webhook retries never send the same email twice.
model EmailLog {
  key       String   @id
  createdAt DateTime @default(now())
}
