generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BroughtBy {
  JASON
  JAD
  CHRISTIANE
  REFERRAL
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  passwordHash String
  name        String
  role        Role     @default(CLIENT)
  createdAt   DateTime @default(now())

  // Admin-controlled account state.
  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(true)

  // Per-client pricing, set by the admin when onboarding.
  oneTimeAmountCents  Int @default(0)
  monthlyAmountCents  Int @default(0)

  // Determines how the monthly subscription is split between partners (see lib/partnerSplit.js).
  broughtBy           BroughtBy @default(JASON)
  supervisingRequired Boolean   @default(true)

  // Stripe linkage.
  stripeCustomerId String?              @unique
  oneTimePaidAt    DateTime?
  subscriptionId   String?              @unique
  subscriptionStatus SubscriptionStatus @default(NONE)
}
