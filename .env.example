# Postgres connection string (Railway auto-injects this once a Postgres addon is attached).
DATABASE_URL="postgresql://user:password@localhost:5432/kedros"

# Auth.js
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:5000"

# Stripe (test mode keys while developing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Used only by `npm run seed` to create the first admin account.
ADMIN_EMAIL="you@kedros.dev"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Jason"
