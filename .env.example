# Postgres connection string (Railway auto-injects this once a Postgres addon is attached).
DATABASE_URL="postgresql://user:password@localhost:5432/kedros"

# Auth.js
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:5000"

# Public site URL, used for canonical links, sitemap, and social share tags.
NEXT_PUBLIC_SITE_URL="https://kedros.dev"

# Stripe (test mode keys while developing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Transactional email via Resend (setup/one-off invoice links and subscription receipts).
# Leave unset to fall back to Stripe's own invoice emails for one-off invoices.
RESEND_API_KEY="re_..."
EMAIL_FROM="Kedros <billing@kedros.dev>"

# Used only by `npm run seed` to create the first admin account.
ADMIN_EMAIL="you@kedros.dev"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Jason"
